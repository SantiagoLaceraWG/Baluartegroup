---
import { featuredProducts } from '../data/products.js';
const [main, ...rest] = featuredProducts;
---

<section class="featured">
  <div class="container">
    <div class="section-header">
      <h2>Productos Destacados</h2>
      <p>Los favoritos de nuestros clientes</p>
    </div>

    <div class="featured-layout">
      <!-- Main featured -->
      <div class="featured-main">
        <div class="featured-main-img">
          <img src={main.img} alt={main.name} loading="lazy" />
          <span class="featured-badge badge-bestseller">Best Seller</span>
        </div>
        <div class="featured-main-info">
          <span class="featured-category">{main.category}</span>
          <h3>{main.name}</h3>
          <div class="featured-rating">
            {'★'.repeat(Math.round(main.rating))}
            <span>({main.reviews} reseñas)</span>
          </div>
          <p class="featured-desc">
            El producto mas vendido de nuestra tienda. Calidad profesional
            garantizada con miles de clientes satisfechos.
          </p>
          <a
            class="btn btn-accent"
            href={`https://wa.me/16898084710?text=Hola, me interesa el producto: ${encodeURIComponent(main.name)}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            Cotizar Ahora
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </a>
        </div>
      </div>

      <!-- Side cards -->
      <div class="featured-side">
        {
          rest.map((p) => (
            <div class="featured-card">
              <div class="featured-card-img">
                <img src={p.img} alt={p.name} loading="lazy" />
                {p.badge && (
                  <span
                    class={`featured-badge badge-${p.badge.toLowerCase().replace(' ', '-')}`}
                  >
                    {p.badge}
                  </span>
                )}
              </div>
              <div class="featured-card-info">
                <span class="featured-category">{p.category}</span>
                <h4>{p.name}</h4>
                <div class="featured-rating small">
                  {'★'.repeat(Math.round(p.rating))}
                </div>
                <a
                  class="btn btn-primary btn-sm"
                  href={`https://wa.me/16898084710?text=Hola, me interesa el producto: ${encodeURIComponent(p.name)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Cotizar
                </a>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .featured {
    padding: 96px 0;
    background: var(--clr-surface);
  }

  .featured-layout {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 32px;
    align-items: start;
  }

  .featured-main {
    background: var(--clr-bg);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--clr-border);
  }

  .featured-main-img {
    position: relative;
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .featured-main-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured-main:hover .featured-main-img img {
    transform: scale(1.04);
  }

  .featured-main-info {
    padding: 28px;
  }

  .featured-category {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--clr-accent);
    margin-bottom: 8px;
    display: block;
  }

  .featured-main-info h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    margin-bottom: 10px;
    line-height: 1.25;
  }

  .featured-rating {
    color: #f59e0b;
    font-size: 1rem;
    margin-bottom: 12px;
  }

  .featured-rating span {
    color: var(--clr-muted);
    font-size: 0.85rem;
  }

  .featured-rating.small {
    font-size: 0.85rem;
    margin-bottom: 8px;
  }

  .featured-desc {
    color: var(--clr-muted);
    font-size: 0.9rem;
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .featured-price {
    display: flex;
    align-items: baseline;
    gap: 10px;
    margin-bottom: 24px;
  }

  .price-current {
    font-family: var(--font-display);
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--clr-primary);
  }

  .featured-card .price-current {
    font-size: 1.2rem;
    display: block;
    margin-bottom: 12px;
  }

  .price-original {
    font-size: 1rem;
    color: var(--clr-muted);
    text-decoration: line-through;
  }

  /* Badges */
  .featured-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    padding: 5px 12px;
    border-radius: var(--radius-full);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: white;
  }

  .badge-bestseller,
  .badge-best-seller {
    background: var(--clr-badge-best);
  }
  .badge-sale {
    background: var(--clr-badge-sale);
  }
  .badge-new {
    background: var(--clr-badge-new);
  }
  .badge-popular {
    background: var(--clr-badge-popular);
  }
  .badge-premium {
    background: var(--clr-badge-premium);
  }
  .badge-trending {
    background: var(--clr-badge-trending);
  }
  .badge-limited {
    background: var(--clr-badge-limited);
  }
  .badge-professional {
    background: var(--clr-badge-premium);
  }

  .featured-side {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .featured-card {
    display: flex;
    gap: 16px;
    background: var(--clr-bg);
    border: 1px solid var(--clr-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: all var(--transition);
  }

  .featured-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateX(4px);
  }

  .featured-card-img {
    position: relative;
    width: 140px;
    min-width: 140px;
    aspect-ratio: 1;
  }

  .featured-card-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .featured-card-info {
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .featured-card-info h4 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-bottom: 4px;
    line-height: 1.3;
  }

  .btn-sm {
    padding: 8px 16px;
    font-size: 0.82rem;
  }

  @media (max-width: 900px) {
    .featured-layout {
      grid-template-columns: 1fr;
    }
    .featured-side {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .featured-card {
      flex: 1;
      min-width: 200px;
    }
  }
</style>
