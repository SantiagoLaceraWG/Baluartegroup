---

<section class="hero">
  <div class="hero-bg">
    <div class="hero-blob hero-blob-1"></div>
    <div class="hero-blob hero-blob-2"></div>
    <div class="hero-grain"></div>
  </div>

  <div class="container hero-inner">
    <div class="hero-content fade-up">
      <div class="hero-badge">
        <span class="badge-dot"></span>
        Nuevos Productos 2026
      </div>

      <h1 class="hero-title">
        Descubre la<br />
        <em>Mejor Selección</em><br />
        de Productos
      </h1>

      <p class="hero-subtitle">
        Encuentra herramientas profesionales, productos de belleza y artículos
        para el hogar. Todo lo que necesitas en un solo lugar con envío rápido.
      </p>

      <div class="hero-cta">
        <a href="#products" class="btn btn-primary">
          Explorar Tienda
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3"></path>
          </svg>
        </a>
        <a href="#categories" class="btn btn-outline">Ver Ofertas</a>
      </div>

      <div class="hero-stats">
        <div class="stat">
          <span class="social-links">
            <a
              href="https://www.facebook.com/people/Baluarte-Group/61588852478112/"
              aria-label="Facebook"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="currentColor"
                viewBox="0 0 24 24"
                ><path
                  d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z"
                ></path></svg
              >
            </a></span
          >
          <span class="stat-label">Facebook</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="social-links">
            <a
              href="https://www.instagram.com/baluartegroupllc"
              aria-label="Facebook"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
                ><rect x="2" y="2" width="20" height="20" rx="5" ry="5"
                ></rect><path d="M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z"
                ></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"
                ></line></svg
              >
            </a></span
          >
          <span class="stat-label">Instagram</span>
        </div>
      </div>
    </div>

    <div class="hero-visual fade-in">
      <div class="hero-images">
        <div class="hero-img hero-img-main">
          <img
            src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/Secador%20de%20Cabello%203%20en%201-ADjYcjdSGBp7mzWWbIqJ2wcvd8qDIP.avif"
            alt="Secador de Cabello 3 en 1"
            loading="eager"
          />
        </div>
        <div class="hero-img hero-img-top">
          <img
            src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/BAHCO%20BE-9881S%20-%20Insulated%20Screwdriver%20Set%20%285%20pcs%29-GWy8jmeIxkjvCGuaS6uVjMYQo5VoHx.png"
            alt="BAHCO Screwdriver Set"
            loading="eager"
          />
        </div>
        <div class="hero-img hero-img-bottom-left">
          <img
            src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/LP%20Vinyl-FRX5mjwVAfjvdK2yDSpCEy8BhfZJM5.webp"
            alt="LP Vinyl Selena"
            loading="eager"
          />
        </div>
        <div class="hero-img hero-img-bottom-right">
          <img
            src="https://hebbkx1anhila5yf.public.blob.vercel-storage.com/Kit%20brocha%20de%20maquillajes-Zs49tLmd9AWMLdYLTB15ya7bNwab1C.webp"
            alt="Kit Brocha de Maquillaje"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-top: 70px;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.5;
  }

  .hero-blob-1 {
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, #f0e6da, transparent);
    top: -100px;
    right: -100px;
  }

  .hero-blob-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, #e8ddd6, transparent);
    bottom: -50px;
    left: 10%;
  }

  .social-links {
    display: flex;
    gap: 12px;
  }

  .social-links a {
    width: 38px;
    height: 38px;
    background: var(--clr-primary);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255, 255, 255, 0.7);
    transition: all var(--transition);
  }

  .social-links a:hover {
    background: var(--clr-accent);
    color: white;
    transform: translateY(-2px);
  }

  .hero-grain {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='0.04'/%3E%3C/svg%3E");
    opacity: 0.4;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
    padding-top: 60px;
    padding-bottom: 60px;
    min-height: calc(100vh - 70px);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: var(--clr-accent-light);
    color: var(--clr-accent-dark);
    border: 1px solid rgba(200, 149, 106, 0.3);
    padding: 8px 16px;
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 24px;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: var(--clr-accent);
    border-radius: 50%;
    animation: pulse 2s ease infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(0.8);
    }
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 24px;
    letter-spacing: -0.02em;
    color: var(--clr-primary);
  }

  .hero-title em {
    font-style: italic;
    color: #e9a76c;
  }

  .hero-subtitle {
    color: var(--clr-muted);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 36px;
    max-width: 480px;
  }

  .hero-cta {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .stat {
    display: flex;
    flex-direction: column;
  }

  .stat-value {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--clr-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--clr-border);
  }

  /* Hero Images */
  .hero-visual {
    position: relative;
    height: 540px;
  }

  .hero-images {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .hero-img {
    position: absolute;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    transition: transform 0.4s ease;
  }

  .hero-img:hover {
    transform: scale(1.03);
  }

  .hero-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-img-main {
    width: 280px;
    height: 360px;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3;
  }

  .hero-img-main:hover {
    transform: translate(-50%, -50%) scale(1.03);
  }

  .hero-img-top {
    width: 160px;
    height: 160px;
    top: 20px;
    right: 30px;
    z-index: 2;
    animation: float 4s ease-in-out infinite;
  }

  .hero-img-bottom-left {
    width: 150px;
    height: 150px;
    bottom: 30px;
    left: 20px;
    z-index: 2;
    animation: float 4s ease-in-out infinite 1s;
  }

  .hero-img-bottom-right {
    width: 140px;
    height: 140px;
    bottom: 60px;
    right: 10px;
    z-index: 2;
    animation: float 4s ease-in-out infinite 2s;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }

    .hero-badge {
      margin: 0 auto 24px;
    }
    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
    .hero-cta {
      justify-content: center;
    }
    .hero-stats {
      justify-content: center;
    }
    .hero-visual {
      height: 380px;
      margin: 0 auto;
      max-width: 400px;
      width: 100%;
    }
  }

  @media (max-width: 480px) {
    .hero-visual {
      height: 300px;
    }
    .hero-img-main {
      width: 200px;
      height: 260px;
    }
    .hero-img-top,
    .hero-img-bottom-left,
    .hero-img-bottom-right {
      width: 110px;
      height: 110px;
    }
  }
</style>
